{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**"
  ],
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "import", "promise", "vitest"],
  "jsPlugins": [
    { "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" },
    { "name": "local", "specifier": "./tools/oxlint/local/index.ts" }
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    "max-lines-per-function": "off",
    "import/max-dependencies": "off",
    "no-warning-comments": "off",
    "react/react-in-jsx-scope": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    // The Paseo SDK declares callback props as methods, so destructuring them is flagged.
    "typescript/unbound-method": "off",
    "unicorn/no-array-callback-reference": "off",

    "typescript/no-confusing-void-expression": ["error", { "ignoreArrowShorthand": true }],
    "vitest/consistent-test-it": ["error", { "fn": "test", "withinDescribe": "test" }],
    "func-style": ["error", "declaration"],
    "one-var": ["error", "never"],
    "react/jsx-filename-extension": ["error", { "extensions": [".tsx"], "allow": "as-needed" }],
    "typescript/consistent-type-assertions": [
      "error",
      { "assertionStyle": "as", "objectLiteralTypeAssertions": "never" }
    ],
    "vitest/consistent-test-filename": ["error", { "pattern": ".*\\.test\\.tsx?$" }],
    "typescript/ban-ts-comment": ["error", { "ts-expect-error": true }],
    "max-lines": ["error", { "max": 300, "skipBlankLines": true, "skipComments": true }],

    "no-empty": "error",
    "no-var": "error",
    "prefer-const": "error",
    "prefer-template": "error",
    "object-shorthand": "error",
    "curly": "error",
    "no-nested-ternary": "error",
    "no-param-reassign": "error",
    "arrow-body-style": "error",
    "default-param-last": "error",
    "logical-assignment-operators": "error",
    "no-alert": "error",
    "no-console": "error",
    "no-implicit-coercion": "error",
    "no-multi-assign": "error",
    "no-return-assign": "error",
    "no-sequences": "error",
    "no-template-curly-in-string": "error",
    "operator-assignment": "error",
    "prefer-arrow-callback": "error",
    "prefer-named-capture-group": "error",
    "prefer-object-has-own": "error",
    "prefer-object-spread": "error",
    "prefer-regex-literals": "error",
    "yoda": "error",
    "default-case-last": "error",
    "guard-for-in": "error",
    "no-lone-blocks": "error",
    "no-unreachable-loop": "error",
    "no-use-before-define": "error",
    "no-useless-assignment": "error",
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/consistent-type-specifier-style": "error",
    "import/first": "error",
    "import/no-default-export": "error",
    "import/no-mutable-exports": "error",
    "oxc/bad-bitwise-operator": "error",
    "oxc/no-barrel-file": "error",
    "promise/param-names": "error",
    "promise/prefer-await-to-then": "error",
    "promise/no-return-in-finally": "error",
    "react/self-closing-comp": "error",
    "react/hook-use-state": "error",
    "react/jsx-boolean-value": "error",
    "react/jsx-curly-brace-presence": "error",
    "react/jsx-fragments": "error",
    "react/prefer-function-component": "error",
    "typescript/no-explicit-any": "error",
    "typescript/explicit-module-boundary-types": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-non-null-asserted-nullish-coalescing": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-invalid-void-type": "error",
    "typescript/no-dynamic-delete": "error",
    "typescript/no-namespace": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/prefer-literal-enum-member": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "typescript/prefer-find": "error",
    "typescript/prefer-string-starts-ends-with": "error",
    "typescript/prefer-reduce-type-parameter": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/consistent-type-definitions": "error",
    "typescript/array-type": "error",
    "typescript/prefer-for-of": "error",
    "typescript/adjacent-overload-signatures": "error",
    "typescript/consistent-generic-constructors": "error",
    "typescript/consistent-indexed-object-style": "error",
    "typescript/dot-notation": "error",
    "typescript/method-signature-style": "error",
    "typescript/no-inferrable-types": "error",
    "typescript/prefer-function-type": "error",
    "typescript/prefer-readonly": "error",
    "typescript/prefer-regexp-exec": "error",
    "typescript/promise-function-async": "error",
    "unicorn/no-abusive-eslint-disable": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/throw-new-error": "error",
    "unicorn/catch-error-name": "error",
    "unicorn/consistent-existence-index-check": "error",
    "unicorn/error-message": "error",
    "unicorn/filename-case": "error",
    "unicorn/no-array-for-each": "error",
    "unicorn/no-array-method-this-argument": "error",
    "unicorn/no-process-exit": "error",
    "unicorn/no-unreadable-array-destructuring": "error",
    "unicorn/no-zero-fractions": "error",
    "unicorn/numeric-separators-style": "error",
    "unicorn/prefer-array-index-of": "error",
    "unicorn/prefer-default-parameters": "error",
    "unicorn/prefer-export-from": "error",
    "unicorn/prefer-includes": "error",
    "unicorn/prefer-logical-operator-over-ternary": "error",
    "unicorn/prefer-module": "error",
    "unicorn/prefer-negative-index": "error",
    "unicorn/prefer-number-properties": "error",
    "unicorn/prefer-object-from-entries": "error",
    "unicorn/prefer-optional-catch-binding": "error",
    "unicorn/prefer-spread": "error",
    "unicorn/prefer-string-trim-start-end": "error",
    "unicorn/prefer-structured-clone": "error",
    "unicorn/require-array-join-separator": "error",
    "unicorn/switch-case-braces": "error",
    "unicorn/text-encoding-identifier-case": "error",
    "unicorn/no-array-reduce": "error",
    "unicorn/no-await-expression-member": "error",
    "unicorn/no-useless-iterator-to-array": "error",
    "unicorn/prefer-modern-math-apis": "error",
    "vitest/prefer-strict-equal": "error",
    "vitest/no-identical-title": "error",
    "vitest/no-alias-methods": "error",
    "vitest/no-duplicate-hooks": "error",
    "vitest/no-import-node-test": "error",
    "vitest/no-test-prefixes": "error",
    "vitest/no-test-return-statement": "error",
    "vitest/prefer-comparison-matcher": "error",
    "vitest/prefer-each": "error",
    "vitest/prefer-equality-matcher": "error",
    "vitest/prefer-expect-resolves": "error",
    "vitest/prefer-hooks-in-order": "error",
    "vitest/prefer-hooks-on-top": "error",
    "vitest/prefer-lowercase-title": "error",
    "vitest/prefer-strict-boolean-matchers": "error",
    "vitest/prefer-to-be": "error",
    "vitest/prefer-to-be-object": "error",
    "vitest/prefer-to-contain": "error",
    "vitest/prefer-to-have-length": "error",
    "vitest/prefer-todo": "error",
    "vitest/max-expects": "error",

    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-readable-spacing": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",

    "local/fast-check-namespace-import": "error",
    "local/fast-check-no-predicate-return": "error",
    "local/fast-check-no-replay": "error",
    "local/fast-check-string-unit": "error",
    "local/no-html-elements": "error",
    "local/no-lint-directives": "error",
    "local/no-vi-stubs": "error",
    "local/stryker-directive-format": "error"
  },
  "overrides": [
    {
      // Paseo, Vitest and Oxlint load these files' default exports.
      "files": ["index.{client,server}.{ts,tsx}", "*.config.*", "tools/oxlint/local/index.ts"],
      "rules": { "import/no-default-export": "off" }
    },
    {
      // Stryker doesn't mutate components or entry points, so logic in them would go untested.
      "files": ["**/*.tsx", "index.{client,server}.{ts,tsx}"],
      "rules": { "complexity": ["error", 3] }
    },
    {
      "files": ["**/*.tsx"],
      "rules": { "react/only-export-components": "error", "local/no-tsx-helpers": "error" }
    },
    {
      "files": ["index.client.{ts,tsx}", "client/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@getpaseo/plugin/client/host",
                "message": "This entry point is for Paseo's app itself, and Paseo rejects plugins that import it."
              }
            ],
            "patterns": [
              {
                "group": ["**/server", "**/server/**", "**/index.server"],
                "message": "Client code runs in the app and can't import daemon code."
              },
              {
                "group": ["node:*"],
                "message": "Client code runs in the app, which has no Node built-ins."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["index.server.{ts,tsx}", "server/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/client", "**/client/**", "**/index.client"],
                "message": "Server code runs in the daemon and can't import app code."
              },
              {
                "regex": "^(react(-dom|-native)?|use-sync-external-store|@tanstack/react-query)(/|$)",
                "message": "Server code runs in the daemon, which has no React."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/client",
                  "**/client/**",
                  "**/index.client",
                  "**/server",
                  "**/server/**",
                  "**/index.server"
                ],
                "message": "Shared code runs in both the app and the daemon, so it can only import shared code."
              },
              {
                "group": ["node:*"],
                "message": "Shared code also runs in the app, which has no Node built-ins."
              },
              {
                "regex": "^(react(-dom|-native)?|use-sync-external-store|@tanstack/react-query)(/|$)",
                "message": "Shared code also runs in the daemon, which has no React."
              }
            ]
          }
        ]
      }
    }
  ]
}
