{
  "name": "better-diff",
  "version": "0.0.0",
  "private": true,
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "scripts": {
    "typecheck": "tsc -b --force && tsc --noEmit -p tools/oxlint",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "knip": "knip && knip --production",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run knip"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.14.0",
    "@oxlint/plugins": "1.90.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "~24.19.2",
    "@types/react": "~19.2.0",
    "knip": "6.44.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.4.3"
  }
}
