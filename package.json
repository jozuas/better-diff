{
  "name": "better-diff",
  "version": "0.0.0",
  "private": true,
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "scripts": {
    "typecheck": "tsc -b --force && tsc --noEmit -p tools/oxlint",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "knip": "knip && knip --production",
    "mutate": "stryker run stryker.config.mts",
    "mutate:changed": "node tools/mutate-changed.mts",
    "mutate:rules": "stryker run stryker.rules.config.mts",
    "check:fast": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run knip",
    "check": "npm run check:fast && npm run mutate"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.14.0",
    "@oxlint/plugins": "1.90.0",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/api": "10.1.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/instrumenter": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "~24.19.2",
    "@types/react": "~19.2.0",
    "fast-check": "^4.10.2",
    "knip": "6.44.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.4.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.0",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "fsevents": false
  }
}
